# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (voice transcription via Whisper API — leave blank to fall back to
# the on-LAN Wyoming/Whisper endpoint set via WHISPER_HOST/WHISPER_PORT)
OPENAI_API_KEY=
TRANSCRIBE_BACKEND=openai

# Home Assistant
HA_BASE_URL=http://supervisor/core
HA_LONG_LIVED_TOKEN=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email (IMAP read-only; app password, not account password)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# When true (Item 20+21), fetched emails are auto-fed through the receipt +
# iCal extractors — receipts become household expenses (broadcast), iCal
# events become per-sender agenda items. Default off; the read-only email
# surface shipped in Item 19 is unaffected.
EMAIL_AUTO_EXTRACT=false

# Only messages from this number (E.164, no leading +, e.g. 972501234567) are accepted
ALLOWED_SENDER_NUMBER=

# Path to the entity catalog, relative to the app working directory
ENTITIES_CONFIG_PATH=config/entities.yaml

# Seconds before a pending risky-action confirmation expires
CONFIRMATION_TTL_SECONDS=120

# Item 22: spam auto-triage. Hard safety switch — the scanner can move email
# to the Spam folder ONLY when this is true. Default false; flip after
# reviewing the dry-run audit log via `show_spam_audit` in WhatsApp.
EMAIL_WRITE_ENABLED=false
# Blank → auto-detect ([Gmail]/Spam, Yahoo "Bulk Mail", iCloud "Junk").
EMAIL_SPAM_FOLDER=
# Comma-separated case-insensitive substrings; matching From addresses are
# never touched regardless of classifier verdict.
EMAIL_SPAM_ALLOWLIST=
# Haiku 4.5 is the cost-optimised default (~$2/month at typical household
# volume). Override only if Haiku misbehaves on your inbox.
EMAIL_SPAM_CLASSIFIER_MODEL=claude-haiku-4-5
